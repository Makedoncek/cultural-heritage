{
  "info": {
    "name": "CultureMap Ukraine — All API Endpoints",
    "description": "Full REST API collection for CultureMap. Login first to populate accessToken/refreshToken. Other variables: baseUrl, objectId, tagId, photoId, userId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "objectId", "value": "1"},
    {"key": "tagId", "value": "1"},
    {"key": "photoId", "value": ""},
    {"key": "userId", "value": "1"},
    {"key": "username", "value": "alecs7turbo"},
    {"key": "password", "value": "SecurePass123!"},
    {"key": "email", "value": "test@example.com"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (JWT)",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const data = pm.response.json();",
            "if (data.access) pm.collectionVariables.set('accessToken', data.access);",
            "if (data.refresh) pm.collectionVariables.set('refreshToken', data.refresh);",
            "pm.test('Has access token', () => pm.expect(data).to.have.property('access'));"
          ]}}]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/refresh/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const data = pm.response.json();",
            "if (data.access) pm.collectionVariables.set('accessToken', data.access);",
            "if (data.refresh) pm.collectionVariables.set('refreshToken', data.refresh);"
          ]}}]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"newuser123\",\n  \"email\": \"newuser123@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"password2\": \"SecurePass123!\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "description": "Creates inactive user, sends verification email."
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ]}}]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/verify-email/?token=PASTE_TOKEN", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-email", ""], "query": [{"key": "token", "value": "PASTE_TOKEN"}]},
            "description": "Token comes from verification email link."
          }
        },
        {
          "name": "Password reset request",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/password-reset/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "password-reset", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        },
        {
          "name": "Password reset confirm",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/password-reset/confirm/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "password-reset", "confirm", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"uid\": \"PASTE_UID\",\n  \"token\": \"PASTE_TOKEN\",\n  \"password\": \"NewSecurePass123!\",\n  \"password2\": \"NewSecurePass123!\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/auth/resend-verification/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-verification", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/health/", "host": ["{{baseUrl}}"], "path": ["api", "health", ""]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has status field', () => pm.expect(pm.response.json()).to.have.property('status'));"
          ]}}]
        },
        {
          "name": "OpenAPI schema (debug only)",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/schema/", "host": ["{{baseUrl}}"], "path": ["api", "schema", ""]}
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/tags/?tag_type=object", "host": ["{{baseUrl}}"], "path": ["api", "tags", ""], "query": [{"key": "tag_type", "value": "object", "description": "object | event"}]}
          }
        },
        {
          "name": "Retrieve tag",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/tags/{{tagId}}/", "host": ["{{baseUrl}}"], "path": ["api", "tags", "{{tagId}}", ""]}
          }
        }
      ]
    },
    {
      "name": "Objects",
      "item": [
        {
          "name": "List objects (filterable)",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {
              "raw": "{{baseUrl}}/api/objects/?search=&tags=&object_type=&event_status=&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "objects", ""],
              "query": [
                {"key": "search", "value": "", "description": "Substring in title/description"},
                {"key": "tags", "value": "", "description": "Tag slugs comma-separated, e.g. zamok,muzey"},
                {"key": "object_type", "value": "", "description": "permanent | event"},
                {"key": "event_status", "value": "", "description": "active | upcoming | finished (events only)"},
                {"key": "page", "value": "1"}
              ]
            }
          }
        },
        {
          "name": "Retrieve object",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", ""]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has photos array', () => pm.expect(pm.response.json()).to.have.property('photos'));"
          ]}}]
        },
        {
          "name": "Create object",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/objects/", "host": ["{{baseUrl}}"], "path": ["api", "objects", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Тестовий об'єкт\",\n  \"description\": \"Опис тестового об'єкта.\",\n  \"latitude\": 50.453081,\n  \"longitude\": 30.530756,\n  \"tags\": [{{tagId}}],\n  \"object_type\": \"permanent\",\n  \"wikipedia_url\": \"https://uk.wikipedia.org/wiki/Test\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const data = pm.response.json();",
            "if (data.id) pm.collectionVariables.set('objectId', data.id);"
          ]}}]
        },
        {
          "name": "Update object (PATCH)",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Оновлена назва\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        },
        {
          "name": "Archive object (soft delete)",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", ""]}
          }
        },
        {
          "name": "My objects",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/objects/my/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "my", ""]}
          }
        },
        {
          "name": "Toggle favorite",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/favorite/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "favorite", ""]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has is_favorited', () => pm.expect(pm.response.json()).to.have.property('is_favorited'));"
          ]}}]
        },
        {
          "name": "List favorites",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/objects/favorites/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "favorites", ""]}
          }
        },
        {
          "name": "Popular objects",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/objects/popular/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "popular", ""]}
          }
        }
      ]
    },
    {
      "name": "Photos (nested under objects)",
      "item": [
        {
          "name": "Upload photo",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/photos/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "photos", ""]},
            "body": {"mode": "formdata", "formdata": [{"key": "image", "type": "file", "src": []}, {"key": "caption", "value": "Тестовий підпис", "type": "text"}]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const data = pm.response.json();",
            "if (data.id) pm.collectionVariables.set('photoId', data.id);"
          ]}}]
        },
        {
          "name": "List photos",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/photos/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "photos", ""]}
          }
        },
        {
          "name": "Patch caption",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/photos/{{photoId}}/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "photos", "{{photoId}}", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"caption\": \"Оновлений підпис\"\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        },
        {
          "name": "Reorder photos",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/photos/reorder/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "photos", "reorder", ""]},
            "body": {"mode": "raw", "raw": "{\n  \"order\": [\n    {\"id\": {{photoId}}, \"order\": 0}\n  ]\n}", "options": {"raw": {"language": "json"}}},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          }
        },
        {
          "name": "Delete photo",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/objects/{{objectId}}/photos/{{photoId}}/", "host": ["{{baseUrl}}"], "path": ["api", "objects", "{{objectId}}", "photos", "{{photoId}}", ""]}
          }
        }
      ]
    },
    {
      "name": "User Profiles / Authors",
      "item": [
        {
          "name": "Retrieve author profile",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/users/{{username}}/", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{username}}", ""]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has approved_objects_count', () => pm.expect(pm.response.json()).to.have.property('approved_objects_count'));"
          ]}}]
        },
        {
          "name": "Author's objects",
          "request": {
            "method": "GET",
            "auth": {"type": "noauth"},
            "url": {"raw": "{{baseUrl}}/api/users/{{username}}/objects/", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{username}}", "objects", ""]}
          }
        },
        {
          "name": "Toggle follow",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/users/{{username}}/follow/", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{username}}", "follow", ""]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has is_followed', () => pm.expect(pm.response.json()).to.have.property('is_followed'));"
          ]}}]
        },
        {
          "name": "List followed authors",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/users/favorite-authors/", "host": ["{{baseUrl}}"], "path": ["api", "users", "favorite-authors", ""]}
          }
        }
      ]
    }
  ]
}
